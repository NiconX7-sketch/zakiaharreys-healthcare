{
  "version": 2,
  "name": "zakiyah-healthcare",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/*.css", "use": "@vercel/static" },
    { "src": "js/*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/index", "dest": "/index.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/products", "dest": "/products.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/blog-post", "dest": "/blog-post.html" },
    { "src": "/corporate-wellness", "dest": "/corporate-wellness.html" },
    { "src": "/wellness-program", "dest": "/wellness-program.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/success", "dest": "/success.html" },
    { "src": "/failure", "dest": "/failure.html" },
    { "src": "/(.*)", "dest": "/$1.html" }
  ]
}
